#!/usr/bin/make -f
# kilix-95 is pure Python and data. The tree the launcher runs goes in
# /usr/share/kilix-95 with a PACKAGED marker; tests, maintainer tools and the
# README screenshot stay in the source.

D := debian/kilix-95/usr/share/kilix-95
SKIP := debian tests tools docs README.md LICENSE

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	install -d $(D)
	set -e; for entry in *; do \
	  case " $(SKIP) " in *" $$entry "*) continue ;; esac; \
	  cp -a "$$entry" $(D)/; \
	done
	find $(D) -depth -name __pycache__ -type d -exec rm -rf {} +
	echo deb > $(D)/PACKAGED

override_dh_installdocs:
	dh_installdocs README.md assets/sounds/PROVENANCE.md
